node_modules
dist
.env
.env.local
.env*.local
.env.tracker-bridge
.claude
supabase/.temp
sluggers-stat-tracker-advanced-stats-dev/preview-session.log

# Raw tracker session logs, now one file per session and written by BOTH the
# standalone preview and the live bridge. 93 MB and growing; distilled into
# data/flight_archive.jsonl.gz (about 4% of the bytes), which is what gets
# committed. The line above is the old single-file name, kept so an existing
# checkout does not suddenly start offering it.
sluggers-stat-tracker-advanced-stats-dev/preview-sessions/

# Raw fence-calibration coordinate dumps (large, regenerable by replaying a
# session). The derived geometry is what gets committed, not the samples.
scripts/fence_samples/

# Local safety snapshots written by the one-time world-scale migration.
scripts/.world_scale_backfill.json*

# Lineup payloads exported from the site for MSS-AutoTeam. Regenerated on
# demand from Supabase, so there is nothing to keep.
scripts/.mss_lineup.json
lineup.json

# Raw player-tracking captures. Whole-game-state frames at 60 Hz -- tens of
# megabytes per session and regenerable only by playing the innings again, so
# they are kept locally rather than committed. The derived per-play metrics
# (.plays.jsonl) and the session headers are small and are left tracked.
data/player_tracking/*.bin

# One-time MEM2 copies taken at the start and end of a Wario City session, so
# the arrow and manhole objects can be searched for offline without replaying
# the game. 16 MB each, regenerable only by playing again -- same trade as the
# frames above, and read only by the stadium-object analysis.
data/player_tracking/*.memdump.zlib
data/player_tracking/*.memdump-end.zlib

# Whole-memory copies taken by memory_probe.py at throws and knockdowns, for
# values the 60 Hz capture does not contain. Megabytes per copy, research only.
data/player_tracking/*.probe/

# Raw stadium memory-probe dumps. Per-frame object/signal captures written by
# probe_stadium_objects.py and probe_stadium_signals.py -- dk_objects.jsonl
# alone is 1.1 GB and is read by probe_stadium_objects.py --analyze. Ignored
# research captures may be unique: re-running a probe or retaining findings
# in docs/tracker-validation-console.md does not recover the same observations.
data/calibration/dk_*.jsonl
data/calibration/stadium_objects.jsonl
data/calibration/stadium_signals.jsonl

# Built tracker binaries. ~10 MB per release; historical builds remain in Git
# history, but new builds are local. Force-add (git add -f) to ship one.
sluggers-stat-tracker-advanced-stats-dev/*.exe

# Raw per-game tracker logs are read by extract_batted_balls.mjs and
# projection_error.mjs. Ignored logs may contain unique observations and must
# not be treated as disposable; tracked .xlsx outputs cannot restore them.
sluggers-stat-tracker-advanced-stats-dev/output/*.log

# Scratch: review logs, screenshots, one-off repro scripts and fixtures.
/tmp/

# Python bytecode.
__pycache__/
*.pyc

# Chromium/Electron stderr noise from the desktop shell.
/debug.log
data/tracker_bridge_state/logs/
